#!/usr/bin/env bash

# Editors & environment
export EDITOR=vim
export VISUAL=vim
export CLICOLOR=1

# Prepend local binaries
case ":${PATH}:" in
    *:"${HOME}/.local/bin":*) ;;
    *) export PATH="${HOME}/.local/bin:${PATH}" ;;
esac

# Append optional directories if they exist
for dir in \
    "${HOME}/.elan/bin" \
    /usr/local/smlnj/bin \
    "${HOME}/.antigravity-ide/antigravity-ide/bin"
do
    if [[ -d "${dir}" ]]; then
        case ":${PATH}:" in
            *:"${dir}":*) ;;
            *) export PATH="${PATH}:${dir}" ;;
        esac
    fi
done

if [[ -f "${HOME}/.ghcup/env" ]]; then
    # shellcheck source=/dev/null
    . "${HOME}/.ghcup/env"
fi
