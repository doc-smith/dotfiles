# Editors
export EDITOR=vim
export VISUAL=vim

# Enable colorized `ls` output.
# This is equivalent to the `-G` flag.
export CLICOLOR=1

# Ensure path entries are unique
typeset -U path

# Prepend local binaries
path=(
    "$HOME/.local/bin"
    $path
)

# Append optional directories if they exist
for dir in \
    "$HOME/.elan/bin" \
    /usr/local/smlnj/bin \
    "$HOME/.antigravity-ide/antigravity-ide/bin"
do
    if [[ -d "$dir" ]]; then
        path+=("$dir")
    fi
done
